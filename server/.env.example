PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
# Leave empty or set to local/cloud MongoDB. If MongoDB is not reachable locally,
# the server will automatically spin up an in-memory MongoDB instance for development.
MONGODB_URI=mongodb://127.0.0.1:27017/talkme

# JWT Secrets (Use strong random strings in production)
JWT_ACCESS_SECRET=talkme_jwt_access_secret_super_key_38291048
JWT_REFRESH_SECRET=talkme_jwt_refresh_secret_super_key_92817346
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# File uploads
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads

