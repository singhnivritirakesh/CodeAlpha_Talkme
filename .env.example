# ==========================================
# Talkme Full-Stack RTC Configuration
# ==========================================

# Server Configuration (server/.env)
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration
# Leave as local URI or provide MongoDB Atlas URI: mongodb+srv://...
# If local MongoDB is not running, the server automatically uses persistent local storage for zero-setup execution.
MONGODB_URI=mongodb://127.0.0.1:27017/talkme

# JWT Authentication Secrets
JWT_ACCESS_SECRET=talkme_jwt_access_secret_super_key_38291048
JWT_REFRESH_SECRET=talkme_jwt_refresh_secret_super_key_92817346
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiting & Storage
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads

# Client Configuration (client/.env)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000

